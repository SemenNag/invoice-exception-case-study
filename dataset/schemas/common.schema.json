{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoice-exception-case-study.example/schemas/common.schema.json",
  "title": "Common definitions",
  "description": "Shared primitives for core-v1. Decimal values are strings with a dot separator; floats are not used.",
  "$defs": {
    "schema_version": { "const": "1.0" },
    "policy_ref": { "const": "core-v1" },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "maxLength": 128
    },
    "case_id": { "type": "string", "pattern": "^case-[0-9]{3}$" },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "unit": { "type": "string", "minLength": 1, "maxLength": 16 },
    "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "money": {
      "description": "Non-negative amount with exactly 2 decimals.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$"
    },
    "unit_price": { "$ref": "#/$defs/money" },
    "quantity": {
      "description": "Positive quantity with up to 3 decimals.",
      "type": "string",
      "pattern": "^(?!0+(\\.0+)?$)[0-9]+(\\.[0-9]{1,3})?$"
    },
    "tax_rate": {
      "description": "Tax rate as a fraction, e.g. \"0.20\".",
      "type": "string",
      "pattern": "^(0(\\.[0-9]{1,4})?|1(\\.0{1,4})?)$"
    },
    "decimal": {
      "description": "Any signed decimal; used for calculated values in outputs. Compared as Decimal, not as text.",
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "json_pointer": {
      "description": "RFC 6901 JSON Pointer into the extracted document, e.g. /lines/0/unit_net_price.",
      "type": "string",
      "pattern": "^(/([^~/]|~[01])*)*$"
    },
    "check_code": {
      "enum": [
        "SUPPLIER_IDENTITY",
        "BUYER_IDENTITY",
        "CURRENCY_MATCH",
        "ORDER_MATCH",
        "LINE_MATCH",
        "QTY_RECEIVED",
        "QTY_ORDER_REMAINING",
        "UNIT_PRICE",
        "LINE_ARITHMETIC",
        "TOTALS_ARITHMETIC",
        "BANK_ACCOUNT",
        "DOCUMENT_CONFLICT"
      ]
    },
    "required_fact": {
      "enum": [
        "supplier.registration_id",
        "buyer.registration_id",
        "document.currency",
        "order_reference",
        "line_match",
        "goods_receipts",
        "bank_account"
      ]
    },
    "check_status": { "enum": ["pass", "fail", "unknown", "not_applicable"] },
    "severity": { "enum": ["blocked", "needs_review"] },
    "decision": { "enum": ["clear", "needs_information", "needs_review", "blocked"] },
    "match_source": { "enum": ["deterministic", "agent_proposal", "human_confirmation"] },
    "import_disposition": { "enum": ["new", "duplicate", "conflict"] },
    "line_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_line_id", "order_line_id"],
      "properties": {
        "document_line_id": { "$ref": "#/$defs/id" },
        "order_line_id": { "$ref": "#/$defs/id" }
      }
    }
  }
}
