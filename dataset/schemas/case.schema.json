{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoice-exception-case-study.example/schemas/case.schema.json",
  "title": "Case manifest (cases/case-NNN/case.json)",
  "description": "All paths are relative to the case directory. expected paths are read only by the runner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "policy_ref", "as_of", "input_documents", "steps"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "case_id": { "$ref": "common.schema.json#/$defs/case_id" },
    "policy_ref": { "$ref": "common.schema.json#/$defs/policy_ref" },
    "as_of": { "$ref": "common.schema.json#/$defs/date" },
    "input_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "path", "content_sha256"],
        "properties": {
          "document_id": { "$ref": "common.schema.json#/$defs/id" },
          "path": { "$ref": "#/$defs/relative_path" },
          "content_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    },
    "fixtures": {
      "description": "Reference-only files (e.g. the PDF of a counted original). Not runtime input.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "description"],
        "properties": {
          "path": { "$ref": "#/$defs/relative_path" },
          "description": { "$ref": "common.schema.json#/$defs/text" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "input", "expected"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "input": { "$ref": "#/$defs/relative_path" },
          "expected": { "$ref": "#/$defs/relative_path" }
        }
      }
    }
  },
  "$defs": {
    "relative_path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$" }
  }
}
