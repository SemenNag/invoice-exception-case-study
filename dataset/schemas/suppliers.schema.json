{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoice-exception-case-study.example/schemas/suppliers.schema.json",
  "title": "Supplier directory (context/suppliers.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suppliers"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "suppliers": { "type": "array", "items": { "$ref": "#/$defs/supplier" } }
  },
  "$defs": {
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplier_id", "legal_name", "country", "registration_id", "approved_bank_accounts"],
      "properties": {
        "supplier_id": { "$ref": "common.schema.json#/$defs/id" },
        "legal_name": { "$ref": "common.schema.json#/$defs/text" },
        "country": { "$ref": "common.schema.json#/$defs/country" },
        "registration_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "approved_bank_accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["iban", "bic"],
            "properties": {
              "iban": { "type": "string", "pattern": "^[A-Z]{2}[0-9]{2}[A-Z0-9]{8,30}$" },
              "bic": { "type": ["string", "null"], "pattern": "^[A-Z0-9]{8}([A-Z0-9]{3})?$" }
            }
          }
        }
      }
    }
  }
}
