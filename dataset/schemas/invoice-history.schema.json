{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoice-exception-case-study.example/schemas/invoice-history.schema.json",
  "title": "Previously counted invoices (context/invoice-history.json)",
  "description": "lines feed R3 quantity history; normalized_facts feed R6 duplicate/conflict comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "documents"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "documents": { "type": "array", "items": { "$ref": "#/$defs/history_document" } }
  },
  "$defs": {
    "history_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id", "supplier_id", "buyer_id", "document_type", "document_number",
        "currency", "status", "matched_order_id", "content_sha256", "lines", "normalized_facts"
      ],
      "properties": {
        "document_id": { "$ref": "common.schema.json#/$defs/id" },
        "supplier_id": { "$ref": "common.schema.json#/$defs/id" },
        "buyer_id": { "$ref": "common.schema.json#/$defs/id" },
        "document_type": { "const": "invoice" },
        "document_number": { "type": "string", "minLength": 1, "maxLength": 64 },
        "currency": { "$ref": "common.schema.json#/$defs/currency" },
        "status": { "const": "counted" },
        "matched_order_id": { "$ref": "common.schema.json#/$defs/id" },
        "content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document_line_id", "order_line_id", "quantity"],
            "properties": {
              "document_line_id": { "$ref": "common.schema.json#/$defs/id" },
              "order_line_id": { "$ref": "common.schema.json#/$defs/id" },
              "quantity": { "$ref": "common.schema.json#/$defs/quantity" }
            }
          }
        },
        "normalized_facts": { "$ref": "#/$defs/normalized_facts" }
      }
    },
    "normalized_facts": {
      "description": "Facts compared by R6 after normalization. Descriptions, payment terms, layout, file name and hash are excluded.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_date", "due_date", "currency", "purchase_order_reference", "iban",
        "declared_subtotal", "declared_tax_total", "declared_total", "lines"
      ],
      "properties": {
        "issue_date": { "$ref": "common.schema.json#/$defs/date" },
        "due_date": { "oneOf": [{ "$ref": "common.schema.json#/$defs/date" }, { "type": "null" }] },
        "currency": { "oneOf": [{ "$ref": "common.schema.json#/$defs/currency" }, { "type": "null" }] },
        "purchase_order_reference": { "type": ["string", "null"] },
        "iban": { "type": ["string", "null"] },
        "declared_subtotal": { "$ref": "common.schema.json#/$defs/money" },
        "declared_tax_total": { "$ref": "common.schema.json#/$defs/money" },
        "declared_total": { "$ref": "common.schema.json#/$defs/money" },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sku", "quantity", "unit", "unit_net_price", "tax_rate", "declared_net_amount", "declared_tax_amount"],
            "properties": {
              "sku": { "type": ["string", "null"] },
              "quantity": { "$ref": "common.schema.json#/$defs/quantity" },
              "unit": { "$ref": "common.schema.json#/$defs/unit" },
              "unit_net_price": { "$ref": "common.schema.json#/$defs/unit_price" },
              "tax_rate": { "$ref": "common.schema.json#/$defs/tax_rate" },
              "declared_net_amount": { "$ref": "common.schema.json#/$defs/money" },
              "declared_tax_amount": { "oneOf": [{ "$ref": "common.schema.json#/$defs/money" }, { "type": "null" }] }
            }
          }
        }
      }
    }
  }
}
